# prep configuration. config.yaml.dist is the project's shared default;
# copy it to config.yaml (gitignored) to make your own, which replaces it.
# views: saved queries (prep list flags), shown as tabs in prep tui.
views:
  Attention: --stale
  Actionable: --actionable
  In progress: --state in-progress
  To enrich: --state defined
  To define: --state open
  All: ""
